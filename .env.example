# Hippo Memory Hub Configuration
# Copy this file to ~/.hippo/.env or ./.env

# LLM & Embedding Provider: "gemini" | "vertexai" | "openai"
# Default is "auto". Auto detects API-key providers only; Vertex AI is opt-in.
HIPPO_PROVIDER=auto

# Google Gemini Developer API Configuration
GOOGLE_API_KEY=
# or GEMINI_API_KEY=
GEMINI_LLM_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-2

# Google Vertex AI Configuration (Optional)
# Set HIPPO_PROVIDER=vertexai explicitly; authenticate locally with:
#   gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
VERTEX_LLM_MODEL=gemini-3.5-flash-lite
VERTEX_EMBEDDING_MODEL=gemini-embedding-2
VERTEX_EMBEDDING_DIMS=768

# OpenAI Configuration (Optional)
OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Storage & User Defaults
# HIPPO_USER_ID defaults to your OS login name if left unset
HIPPO_USER_ID=default
HIPPO_STORAGE_DIR=~/.hippo/storage

# Retrieval gate tuning (internal; do not expose through MCP).
# These defaults are part of the reproducible evaluation manifest.
HIPPO_FINAL_THRESHOLD=0.32
HIPPO_DENSE_ONLY_THRESHOLD=0.62
HIPPO_RELATIVE_RATIO=0.50
HIPPO_LEXICAL_MIN_COVERAGE=0.35
HIPPO_LEXICAL_BM25_THRESHOLD=0.15
HIPPO_LEXICAL_SEMANTIC_THRESHOLD=0.48

# Optional Qdrant collection override.
# Vertex AI uses an isolated model/dimension-specific collection by default.
# HIPPO_COLLECTION_NAME=hippo_memories_custom
