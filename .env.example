# Hippo Memory Hub Configuration
# Copy this file to ~/.hippo/.env or ./.env

# LLM & Embedding Provider: "gemini" | "openai" | "deepseek" | "ollama"
# Default is "auto" (automatically detects available API keys)
HIPPO_PROVIDER=auto

# Google Gemini Configuration
GOOGLE_API_KEY=
# or GEMINI_API_KEY=
GEMINI_LLM_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-2

# OpenAI Configuration (Optional)
OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Storage & User Defaults
HIPPO_USER_ID=default
HIPPO_STORAGE_DIR=~/.hippo/storage
